{
  "name": "atb-web",
  "version": "1.15.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/restore-embed-placeholder.mjs",
    "start": "node -e \"console.error('Unsupported: this project is a static export. Serve web/out with a static file server.'); process.exit(1)\"",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:a11y": "npm run build",
    "test:a11y": "CYPRESS_MOCK_API=true CYPRESS_BASE_URL=http://127.0.0.1:3000 ./scripts/run-static-cypress.sh cypress/e2e/a11y.cy.ts",
    "e2e": "cypress run",
    "pretest:e2e": "npm run build",
    "test:e2e": "CYPRESS_BASE_URL=http://127.0.0.1:3000 ./scripts/run-static-cypress.sh cypress/e2e/dashboard.cy.ts",
    "test:e2e:open": "cypress open",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.544.0",
    "next": "16.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.3.1",
    "react-window": "^1.8.10",
    "reactflow": "^11.11.4",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.0.1",
    "cypress": "^15.14.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.10",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "glob": "^11.0.0",
    "minimatch": "9.0.7",
    "postcss": "^8.5.10",
    "rimraf": "^5.0.0"
  }
}
