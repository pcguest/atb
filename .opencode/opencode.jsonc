{
  // ATB local development harness — OpenCode configuration.
  //
  // This file is the SINGLE SOURCE OF TRUTH for local model routing.
  // No ATB product code (Go/TS/Python) may contain model names.
  //
  // Boundary: this directory is LOCAL development tooling. It is committed
  // in this branch as development harness configuration. ATB must never depend on it.
  //
  // Correct OpenCode keys: `agent` (singular), `permission`, `mcp`, `skills`.
  // The previous `agents` key and `permission.yaml` were NOT enforced by OpenCode.
  "$schema": "https://opencode.ai/config.json",

  // Global fallback model (free overflow). Per-agent routing is below.
  "model": "opencode/nemotron-3-ultra-free",
  "small_model": "opencode/ling-3.0-flash-fin-free",

  // Prevent recursive swarms. atb-engineer -> specialist/worker -> STOP.
  "subagent_depth": 1,

  // ------------------------------------------------------------------
  // MODEL ROUTING (replaceable). Heterogeneous families by role.
  // Cost classes: go = OpenCode Go allowance; free = free overflow;
  // openai = expensive escalation (documented, not a routine worker).
  // ------------------------------------------------------------------
  "agent": {
    "atb-engineer": {
      "model": "opencode-go/gpt-5.6-luna",
      "mode": "primary",
      "description": "Primary orchestrator. Owns architecture continuity, decomposition, delegation, final deterministic validation."
    },
    "repo-explorer": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "description": "Read-only repository exploration and tracing.",
      "permission": { "edit": "deny", "bash": "deny", "task": "deny" }
    },
    "implementer": {
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent",
      "description": "Bounded write agent. Smallest coherent patch within an explicit task packet.",
      "permission": { "edit": "allow", "task": "deny" }
    },
    "reviewer": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "subagent",
      "description": "Independent falsification reviewer. Different family from the implementer.",
      "permission": { "read": "allow", "edit": "deny", "bash": "deny", "task": "deny", "external_directory": "deny" }
    },
    "adversarial-reviewer": {
      "model": "opencode-go/minimax-m3",
      "mode": "subagent",
      "description": "Security/trust/edge-case adversarial reviewer. Read-only.",
      "permission": { "read": "allow", "edit": "deny", "bash": "deny", "task": "deny", "external_directory": "deny" }
    },
    "practitioner": {
      "model": "opencode-go/mimo-v2.5",
      "mode": "subagent",
      "description": "Task-based unfamiliar-user simulation. Read-only; reports friction, never implements.",
      "permission": { "read": "allow", "edit": "deny", "bash": "deny", "task": "deny", "external_directory": "deny" }
    }
  },

  // ------------------------------------------------------------------
  // PERMISSIONS (least privilege). Enforced by OpenCode.
  // Deny list is intentionally conservative; remote mutations are blocked.
  // ------------------------------------------------------------------
  "permission": {
    "read": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      // Route every Git command through an ask default so global options
      // (e.g. `git -C <repo> push`) cannot bypass the mutation denies below.
      // Read-only Git commands are re-allowed after the denies; last match wins.
      "git *": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git tag*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      // Safe read-only Git commands (explicit allow after the ask default).
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git describe*": "allow",
      "git blame*": "allow",
      "git config --get*": "allow",
      // Any `rm` asks; recursive+force deletion is denied regardless of target.
      // Last matching rule wins, so the broad ask precedes the specific denials.
      "rm *": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -r -f*": "deny",
      "rm -f -r*": "deny",
      "rm --no-preserve-root*": "deny",
      "dd if=* of=/dev/*": "deny",
      "mkfs.*": "deny",
      "mkfs* /dev/*": "deny",
      "chmod -R 000 /": "deny",
      "chmod -R 000 /*": "deny",
      ":(){ :|:& };:": "deny",
      "curl*": "ask",
      "wget*": "ask",
      "ssh*": "deny",
      "scp*": "deny",
      "docker*": "deny",
      "kubectl*": "deny",
      "terraform*": "deny",
      "gh release*": "deny",
      "gh pr merge*": "deny",
      "npm publish*": "deny",
      "go install*": "ask",
      "twine*": "deny"
    }
  },

  // ------------------------------------------------------------------
  // MCP / plugins. Default: none enabled. Native repo/shell/search tools
  // are preferred. Enable on demand only with measured justification.
  // ------------------------------------------------------------------
  "mcp": {}
}
