{
  "name": "@pcguest/atb-sdk",
  "version": "1.15.1",
  "description": "ATB bundle reader and verifier SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "keywords": [
    "audit",
    "ai",
    "traceability",
    "verification",
    "privacy",
    "local-first",
    "atb"
  ],
  "author": "Paddy Guest <patrickcguest@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcguest/atb.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/pcguest/atb",
  "bugs": {
    "url": "https://github.com/pcguest/atb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "9.39.4",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "ai": ">=3.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=18"
  }
}
